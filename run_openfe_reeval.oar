#!/bin/bash
#OAR -n OpenFE_reeval
#OAR -l core=8,walltime=12:00:00
#OAR -q default
#OAR -O /nfs/home/lisic/bschafer/2_metafe/logs/openfe_reeval.%jobid%.out
#OAR -E /nfs/home/lisic/bschafer/2_metafe/logs/openfe_reeval.%jobid%.err

# After regenerating OpenFE data into test_data_openfe_v2/ (run_fe_openfe.oar <id> test_data_openfe_v2):
#   oarsub -S "./run_openfe_reeval.oar <dataset_id>"
# If the new FE file is identical to test_data/FE_<id>_OpenFE.parquet, nothing is done. Otherwise (missing or changed)
# the old file and its OpenFE results are moved to $SUSPECT, the new file is put into test_data/, and every fold that
# already has a combined Result file is re-evaluated (only OpenFE is refit, the other methods come from the cache).

. /nfs/opt/env/env.sh

REPO=/nfs/home/lisic/bschafer/2_metafe/meta-surrogate-feature-engineering
SUSPECT=/nfs/home/lisic/bschafer/2_metafe/openfe_suspect
source ~/venvs/metafe/bin/activate

dataset=$1
echo "Starting OpenFE re-evaluation of dataset $dataset on $(hostname) ($(lscpu | grep 'Model name' | sed 's/.*: *//')) at $(date)"

export PYTHONPATH=$REPO:$PYTHONPATH
cd $REPO/src/Apply_and_Test

new=test_data_openfe_v2/FE_${dataset}_OpenFE.parquet
old=test_data/FE_${dataset}_OpenFE.parquet
R=test_results_same_split
[ -f $new ] || { echo "No new OpenFE data $new"; exit 1; }

if [ -f $old ] && python3 -c "
import sys, pandas as pd
a, b = pd.read_parquet('$old'), pd.read_parquet('$new')
sys.exit(0 if a.equals(b) else 1)"; then
    echo "Dataset $dataset: new OpenFE data identical to the existing one, nothing to do."
    exit 0
fi

echo "Dataset $dataset: OpenFE data $([ -f $old ] && echo changed || echo new), re-evaluating."
mkdir -p $SUSPECT/$R
[ -f $old ] && mv $old $SUSPECT/
for f in $R/OpenFE_Result_${dataset}_*.parquet; do [ -f $f ] && mv $f $SUSPECT/$R/; done
cp $new $old

start=$(date +%s)
status=0
for f in $R/Result_${dataset}_*.parquet; do
    fold=${f##*_}; fold=${fold%.parquet}
    python3 Test_FE.py --dataset "$dataset" --fold "$fold" --skip-missing-fe || status=1
done
end=$(date +%s)

deactivate
echo "Dataset $dataset done (exit $status). Runtime: $((end - start)) s"
exit $status
