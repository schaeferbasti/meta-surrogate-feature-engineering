#!/bin/bash
#OAR -n FE_OpenFE
#OAR -l core=8,walltime=2:00:00
#OAR -q default
#OAR -O /nfs/home/lisic/bschafer/2_metafe/logs/fe_openfe.%jobid%.out
#OAR -E /nfs/home/lisic/bschafer/2_metafe/logs/fe_openfe.%jobid%.err

# Generate the OpenFE data (original OpenML split) for one dataset: oarsub -S "./run_fe_openfe.oar <dataset_id> [<out_dir>]"
# Writes src/Apply_and_Test/test_data/FE_<id>_OpenFE.parquet, which run_test_fe.oar then evaluates.
# All jobs are submitted by submit_same_split.sh.

. /nfs/opt/env/env.sh

REPO=/nfs/home/lisic/bschafer/2_metafe/meta-surrogate-feature-engineering
source ~/venvs/metafe/bin/activate

dataset=$1
n_jobs=$(nproc)  # cores of the OAR cpuset
echo "Starting OpenFE for dataset $dataset with $n_jobs jobs on $(hostname) ($(lscpu | grep 'Model name' | sed 's/.*: *//')) at $(date)"

export PYTHONPATH=$REPO:$PYTHONPATH
cd $REPO/src/Apply_and_Test

start=$(date +%s)
python3 Generate_OpenFE.py --dataset "$dataset" --n_jobs "$n_jobs" --out_dir "${2:-test_data}"
status=$?
end=$(date +%s)

deactivate
echo "OpenFE for dataset $dataset done (exit $status). Runtime: $((end - start)) s"
exit $status
